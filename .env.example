# Required API credentials
GEMINI_API_KEY=
GITHUB_TOKEN=

# Target repository used by the autonomous hunter
TARGET_REPOSITORY=owner/repository
TARGET_ISSUE_NUMBER=

# Optional settings
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEOUT_SECONDS=30
GITHUB_API_BASE_URL=https://api.github.com
BOUNTY_KEYWORDS=bounty,help-wanted
MAX_ISSUES_TO_FETCH=5
